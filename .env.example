# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database ---
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=placement_portal
PG_PASSWORD=
PG_PORT=5432
PG_SSL=false

# --- Auth ---
SESSION_SECRET=change_this_to_a_long_random_string

# --- Email (Nodemailer) ---
# Leave EMAIL_HOST empty for DRY-RUN: emails are built and logged in the server console, never sent.
# For safe testing use a fake inbox. Both of these catch mail without delivering it to anyone:
#   Ethereal  host: smtp.ethereal.email   port: 587   (create a free account at https://ethereal.email/create)
#   Mailtrap  host: sandbox.smtp.mailtrap.io  port: 2525   (free inbox at https://mailtrap.io)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Placement Cell <no-reply@placement.local>"

# Hourly check that reminds eligible students about drives closing within 24 hours
REMINDERS_ENABLED=true